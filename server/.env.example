# Server Port & Environment
PORT=3001
NODE_ENV=development

# Allowed Origins & Frontend Connection
FRONTEND_ORIGIN=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Screenshot Configuration
SCREENSHOT_TIMEOUT_MS=60000
MAX_SCREENSHOT_WIDTH=1920
MAX_SCREENSHOT_HEIGHT=2160

# Supabase Credentials (Private - Server Only)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Optional: Custom Chromium executable path (leave unset for automatic Vercel / local detection)
# CHROMIUM_EXECUTABLE_PATH=
